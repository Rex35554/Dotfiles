layout {

    focus-ring {
        active-color   "#0e6681"
        inactive-color "#f5fafd"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#0e6681"
        inactive-color "#f5fafd"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#0e6681"
        inactive-color "#bbe9ff"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#0e668180"
    }
}

recent-windows {
    highlight {
        active-color "#0e6681"
        urgent-color "#ba1a1a"
    }
}
